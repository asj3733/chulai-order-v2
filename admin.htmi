<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>初萊食麵｜POS 後台</title>
<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}
body {
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Noto Sans TC",
    "Microsoft JhengHei",
    sans-serif;
  background: #f3f3f3;
  color: #222;
  padding-bottom: 90px;
}
/* =========================
   Header
========================= */
.header {
  background: linear-gradient(135deg, #252525, #111);
  color: #fff;
  padding: 18px 16px 20px;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 3px 12px rgba(0,0,0,0.2);
}
.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
}
.brand-logo {
  width: 42px;
  height: 42px;
  border: 2px solid #d4af37;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d4af37;
  font-weight: bold;
  font-size: 18px;
}
.brand-text h1 {
  font-size: 19px;
  letter-spacing: 2px;
}
.brand-text p {
  color: #aaa;
  font-size: 12px;
  margin-top: 2px;
}
.shop-status {
  background: #1d8f4e;
  border-radius: 20px;
  padding: 8px 12px;
  font-size: 13px;
  font-weight: bold;
}
/* =========================
   Main
========================= */
.container {
  max-width: 1100px;
  margin: auto;
  padding: 16px;
}
/* =========================
   Dashboard
========================= */
.dashboard {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-bottom: 18px;
}
.stat-card {
  background: #fff;
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}
.stat-title {
  color: #777;
  font-size: 13px;
  margin-bottom: 8px;
}
.stat-value {
  font-size: 23px;
  font-weight: 800;
}
.stat-card.gold .stat-value {
  color: #b08b00;
}
.stat-card.red .stat-value {
  color: #d64545;
}
.stat-card.green .stat-value {
  color: #16834a;
}
/* =========================
   Section
========================= */
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 22px 0 12px;
}
.section-title h2 {
  font-size: 19px;
}
.section-title span {
  color: #888;
  font-size: 13px;
}
/* =========================
   Order Card
========================= */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.order-card {
  background: #fff;
  border-radius: 18px;
  padding: 16px;
  box-shadow: 0 3px 10px rgba(0,0,0,0.06);
  border-left: 5px solid #d4af37;
}
.order-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.order-number {
  font-size: 18px;
  font-weight: 800;
}
.order-time {
  color: #888;
  font-size: 12px;
  margin-top: 4px;
}
.order-source {
  background: #f5ead0;
  color: #8c6b00;
  border-radius: 20px;
  padding: 5px 10px;
  font-size: 12px;
  font-weight: bold;
}
.customer {
  margin-top: 14px;
  font-size: 14px;
}
.customer strong {
  font-size: 15px;
}
.order-items {
  margin-top: 12px;
  border-top: 1px solid #eee;
  padding-top: 10px;
}
.order-item {
  display: flex;
  justify-content: space-between;
  padding: 5px 0;
  font-size: 14px;
}
.order-item span:last-child {
  font-weight: bold;
}
.order-total {
  display: flex;
  justify-content: space-between;
  border-top: 1px solid #eee;
  margin-top: 10px;
  padding-top: 12px;
  font-size: 17px;
  font-weight: 800;
}
.order-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-top: 14px;
}
.btn {
  border: none;
  border-radius: 12px;
  padding: 13px;
  font-size: 15px;
  font-weight: bold;
  cursor: pointer;
}
.btn-primary {
  background: #222;
  color: #fff;
}
.btn-gold {
  background: #d4af37;
  color: #222;
}
.btn-light {
  background: #eee;
  color: #333;
}
/* =========================
   Quick POS
========================= */
.quick-pos {
  background: #fff;
  border-radius: 18px;
  padding: 16px;
  margin-top: 20px;
  box-shadow: 0 3px 10px rgba(0,0,0,0.06);
}
.quick-pos-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.quick-pos-title h2 {
  font-size: 19px;
}
.quick-pos-title button {
  border: none;
  background: #222;
  color: #fff;
  padding: 9px 13px;
  border-radius: 10px;
  font-weight: bold;
}
.category-tabs {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 10px;
}
.category-tabs button {
  flex-shrink: 0;
  border: 1px solid #ddd;
  background: #fff;
  padding: 9px 14px;
  border-radius: 20px;
  font-size: 13px;
}
.category-tabs button.active {
  background: #222;
  color: #fff;
  border-color: #222;
}
.menu-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}
.menu-item {
  background: #f8f8f8;
  border-radius: 13px;
  padding: 13px;
  cursor: pointer;
  border: 1px solid transparent;
}
.menu-item:active {
  transform: scale(0.97);
}
.menu-item-name {
  font-size: 14px;
  font-weight: bold;
}
.menu-item-price {
  color: #a27b00;
  margin-top: 5px;
  font-weight: bold;
}
/* =========================
   Bottom Navigation
========================= */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 76px;
  background: rgba(255,255,255,0.97);
  backdrop-filter: blur(10px);
  border-top: 1px solid #ddd;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  z-index: 200;
  padding-bottom: env(safe-area-inset-bottom);
}
.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #888;
  font-size: 11px;
  gap: 4px;
}
.nav-item span:first-child {
  font-size: 22px;
}
.nav-item.active {
  color: #b08b00;
  font-weight: bold;
}
/* =========================
   Responsive
========================= */
@media (min-width: 700px) {
  .dashboard {
    grid-template-columns: repeat(3, 1fr);
  }
  .order-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  .menu-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}
</style>
</head>
<body>
<!-- Header -->
<header class="header">
  <div class="header-top">
<div class="brand">
  <div class="brand-logo">
    初
  </div>
  <div class="brand-text">
    <h1>初萊食麵 POS</h1>
    <p>店家管理系統</p>
  </div>
</div>
<div class="shop-status">
  🟢 營業中
</div>
  </div>
</header>
<main class="container">
  <!-- Dashboard -->
  <section class="dashboard">
<div class="stat-card gold">
  <div class="stat-title">
    今日營業額
  </div>
  <div class="stat-value">
    $3,250
  </div>
</div>
<div class="stat-card">
  <div class="stat-title">
    今日訂單
  </div>
  <div class="stat-value">
    42
  </div>
</div>
<div class="stat-card red">
  <div class="stat-title">
    待處理
  </div>
  <div class="stat-value">
    5
  </div>
</div>
  </section>
  <!-- Orders -->
  <section>
<div class="section-title">
  <h2>
    🔴 待處理訂單
  </h2>
  <span>
    共 5 筆
  </span>
</div>
<div class="order-list">
  <!-- Order 1 -->
  <div class="order-card">
    <div class="order-top">
      <div>
        <div class="order-number">
          A001
        </div>
        <div class="order-time">
          今天 11:42
        </div>
      </div>
      <div class="order-source">
        官網訂單
      </div>
    </div>
    <div class="customer">
      👤 <strong>王先生</strong>
      <br>
      📱 09XX-XXX-XXX
      <br>
      🛍️ 外帶
    </div>
    <div class="order-items">
      <div class="order-item">
        <span>肉燥乾麵 大 × 2</span>
        <span>$130</span>
      </div>
      <div class="order-item">
        <span>水餃 × 1</span>
        <span>$50</span>
      </div>
    </div>
    <div class="order-total">
      <span>
        訂單總額
      </span>
      <span>
        $180
      </span>
    </div>
    <div class="order-actions">
      <button class="btn btn-primary"
        onclick="startOrder('A001')">
        接單
      </button>
      <button class="btn btn-light"
        onclick="viewOrder('A001')">
        查看
      </button>
    </div>
  </div>
  <!-- Order 2 -->
  <div class="order-card">
    <div class="order-top">
      <div>
        <div class="order-number">
          A002
        </div>
        <div class="order-time">
          今天 11:47
        </div>
      </div>
      <div class="order-source">
        現場 POS
      </div>
    </div>
    <div class="customer">
      👤 <strong>現場客人</strong>
      <br>
      🪑 內用
    </div>
    <div class="order-items">
      <div class="order-item">
        <span>麻醬麵 大 × 1</span>
        <span>$70</span>
      </div>
      <div class="order-item">
        <span>貢丸湯 × 1</span>
        <span>$40</span>
      </div>
      <div class="order-item">
        <span>滷蛋 × 1</span>
        <span>$15</span>
      </div>
    </div>
    <div class="order-total">
      <span>
        訂單總額
      </span>
      <span>
        $125
      </span>
    </div>
    <div class="order-actions">
      <button class="btn btn-primary"
        onclick="startOrder('A002')">
        開始製作
      </button>
      <button class="btn btn-light"
        onclick="viewOrder('A002')">
        查看
      </button>
    </div>
  </div>
</div>
  </section>
  <!-- Quick POS -->
  <section class="quick-pos">
<div class="quick-pos-title">
  <h2>
    🍜 快速點餐
  </h2>
  <button onclick="openPOS()">
    開始點餐
  </button>
</div>
<div class="category-tabs">
  <button class="active">
    麵類
  </button>
  <button>
    關東煮
  </button>
  <button>
    小菜
  </button>
  <button>
    湯類
  </button>
  <button>
    其他
  </button>
</div>
<div class="menu-grid">
  <div class="menu-item"
    onclick="addItem('肉燥乾麵 小',55)">
    <div class="menu-item-name">
      肉燥乾麵 小
    </div>
    <div class="menu-item-price">
      $55
    </div>
  </div>
  <div class="menu-item"
    onclick="addItem('肉燥乾麵 大',65)">
    <div class="menu-item-name">
      肉燥乾麵 大
    </div>
    <div class="menu-item-price">
      $65
    </div>
  </div>
  <div class="menu-item"
    onclick="addItem('麻醬麵 小',60)">
    <div class="menu-item-name">
      麻醬麵 小
    </div>
    <div class="menu-item-price">
      $60
    </div>
  </div>
  <div class="menu-item"
    onclick="addItem('麻醬麵 大',70)">
    <div class="menu-item-name">
      麻醬麵 大
    </div>
    <div class="menu-item-price">
      $70
    </div>
  </div>
  <div class="menu-item"
    onclick="addItem('鮮蝦餛飩乾麵 小',70)">
    <div class="menu-item-name">
      鮮蝦餛飩乾麵 小
    </div>
    <div class="menu-item-price">
      $70
    </div>
  </div>
  <div class="menu-item"
    onclick="addItem('鮮蝦餛飩湯麵 大',80)">
    <div class="menu-item-name">
      鮮蝦餛飩湯麵 大
    </div>
    <div class="menu-item-price">
      $80
    </div>
  </div>
</div>
  </section>
</main>
<!-- Bottom Navigation -->
<nav class="bottom-nav">
  <div class="nav-item active">
    <span>🏠</span>
    首頁
  </div>
  <div class="nav-item">
    <span>📋</span>
    訂單
  </div>
  <div class="nav-item">
    <span>🍜</span>
    點餐
  </div>
  <div class="nav-item">
    <span>📊</span>
    統計
  </div>
  <div class="nav-item">
    <span>⚙️</span>
    設定
  </div>
</nav>
<script>
/* =========================
   POS Demo Functions
========================= */
function startOrder(orderId) {
  alert(
    "訂單 " + orderId +
    " 已進入製作流程"
  );
}
function viewOrder(orderId) {
  alert(
    "查看訂單：" +
    orderId
  );
}
function openPOS() {
  alert(
    "下一階段將開啟完整 POS 點餐畫面"
  );
}
function addItem(name, price) {
  alert(
    "已加入：" +
    name +
    " $" +
    price
  );
}
</script>
</body>
</html>
